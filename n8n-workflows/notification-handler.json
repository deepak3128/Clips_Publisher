{
  "name": "Notification Handler",
  "nodes": [
    {
      "parameters": {
        "path": "/notifications/event",
        "authType": "bearer",
        "options": {}
      },
      "name": "Notification Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $node[\"Notification Webhook\"].json.channel }}",
              "operation": "equals",
              "value2": "email"
            }
          ]
        }
      },
      "name": "Route by Channel",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [500, 300]
    },
    {
      "parameters": {
        "subject": "={{ $node[\"Notification Webhook\"].json.title }}",
        "toEmail": "={{ $node[\"Notification Webhook\"].json.email }}",
        "message": "={{ $node[\"Notification Webhook\"].json.message }}"
      },
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [750, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "chat_id",
              "value": "={{ $node[\"Notification Webhook\"].json.telegram_chat_id }}"
            },
            {
              "name": "text",
              "value": "={{ $node[\"Notification Webhook\"].json.title }}\\n\\n{{ $node[\"Notification Webhook\"].json.message }}"
            }
          ]
        }
      },
      "name": "Send Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [750, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_URL }}/api/notifications/logged",
        "authentication": "bearer",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "notificationId",
              "value": "={{ $node[\"Notification Webhook\"].json.id }}"
            }
          ]
        }
      },
      "name": "Mark as Logged",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1000, 300]
    }
  ],
  "connections": {
    "Notification Webhook": {
      "main": [
        [
          {
            "node": "Route by Channel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route by Channel": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email": {
      "main": [
        [
          {
            "node": "Mark as Logged",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Telegram": {
      "main": [
        [
          {
            "node": "Mark as Logged",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {}
}
