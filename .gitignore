# Comprehensive .gitignore for AutoShorts Publisher

# Dependencies
node_modules/
*.pnp
.pnp
.yarn/install-state.gz

# Production builds
dist/
build/
.next/
out/
*.tgz

# Environment files
.env
.env.local
.env.*.local
.env.production
.env.production.local
.env.development
.env.development.local

# IDE and Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.sublime-project
.sublime-workspace
*.code-workspace

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp
*.bak

# Database
*.db
*.sqlite
*.sqlite3

# OS files
Thumbs.db
.Thumbs.db

# Docker
.dockerignore

# Testing
jest_cache/
.jest_cache/

# Package manager
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build artifacts
*.o
*.a
*.lib
*.so
*.dll
*.tsbuildinfo

# API keys and secrets (should never be committed)
.env*
!.env.example

# Misc
.cache/
.parcel-cache
dist/
.cache/
.contentlayer
.vercel
.turbo

# Uploaded files (if stored locally for testing)
uploads/
public/uploads/

# n8n workflow backups
n8n_backup/

# Database backups
backups/
*.sql
*.sql.gz
