{
  "name": "autoshorts-publisher-backend",
  "version": "1.0.0",
  "description": "AutoShorts Publisher Backend API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "migrate:up": "knex migrate:latest --knexfile knexfile.ts",
    "migrate:down": "knex migrate:rollback --knexfile knexfile.ts",
    "migrate:make": "knex migrate:make --knexfile knexfile.ts",
    "seed": "knex seed:run --knexfile knexfile.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "express-validator": "^7.0.0",
    "jsonwebtoken": "^9.1.0",
    "bcryptjs": "^2.4.3",
    "pg": "^8.11.3",
    "knex": "^3.1.0",
    "axios": "^1.6.2",
    "multer": "^1.4.5-lts.1",
    "@aws-sdk/client-s3": "^3.465.0",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "pino": "^8.17.2",
    "pino-http": "^8.6.1",
    "nodemailer": "^6.9.7",
    "axios-retry": "^2.8.1",
    "bullmq": "^5.7.0",
    "ioredis": "^5.3.2",
    "google-auth-library": "^9.4.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/multer": "^1.4.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/nodemailer": "^6.4.14",
    "typescript": "^5.3.3",
    "ts-node-dev": "^2.0.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "prettier": "^3.1.1"
  }
}
